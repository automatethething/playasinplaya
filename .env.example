NEXT_PUBLIC_APP_URL=https://playasinplaya.com

# Server-only PostgreSQL. Use the Supabase pooled connection host to avoid a WireGuard dependency.
# Never prefix these values with NEXT_PUBLIC_.
PLAYASINPLAYA_DB_HOST=
PLAYASINPLAYA_DB_PORT=5432
PLAYASINPLAYA_DB_NAME=playasinplaya
PLAYASINPLAYA_DB_USER=playasinplaya_app
PLAYASINPLAYA_DB_PASSWORD=
# PEM CA value for certificate verification when the private database requires one.
PLAYASINPLAYA_DB_SSL_CA=
# Defaults to the app-owned schema. Set to public only for an intentional rollback.
PLAYASINPLAYA_DB_SCHEMA=playasinplaya

# Temporary until intake, admin, and dashboard paths move to PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://logs.petrichorlabs.ca

CONSENTKEYS_CLIENT_ID=
CONSENTKEYS_CLIENT_SECRET=
CONSENTKEYS_ISSUER=https://api.consentkeys.com
CONSENTKEYS_CALLBACK_URL=https://playasinplaya.com/api/auth/callback/consentkeys
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://playasinplaya.com

# Comma-separated ConsentKeys subject IDs permitted to moderate. Empty means deny all access.
ADMIN_USER_IDS=
